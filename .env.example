# =============================================================================
# PolicyLens — Environment Variables Template
# =============================================================================
#
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env     (Linux/macOS)
#      copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
# 2. Replace the placeholder below with your valid Google Gemini API key.
# 3. Obtain a free key from Google AI Studio: https://aistudio.google.com/
#
# NOTE: Never commit your actual '.env' file containing real secrets to git.
# =============================================================================

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Hugging Face User Access Token (Free from https://huggingface.co/settings/tokens)
# When provided on Render, offloads query embedding to HF Serverless Inference API (0 MB RAM).
# If omitted, PolicyLens falls back to local SentenceTransformer embedding.
# HF_TOKEN=hf_your_huggingface_token_here
